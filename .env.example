# ==============================================================================
# ANNASHUWA VTU - Environment Configuration
# Copy this file to `.env` and adjust as needed.
# ==============================================================================

# --- Database ---------------------------------------------------------------
# SQLite (zero-config localhost):
#   DATABASE_URL="file:./dev.db"
#
# For PostgreSQL, change the provider in prisma/schema.prisma to
# "postgresql" and use a connection string such as:
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/annashuwa_vtu"
DATABASE_URL="file:./dev.db"

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="ANNASHUWA VTU"
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=development

# --- Security ---------------------------------------------------------------
# Use a long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-change-me-5f2c9a7d4e8b1a3c6f9d0e2b4a7c8e1f3d5b6a8c9d0e2f4a6b8c0d1e3f5a7b9

# --- Mock / Provider mode ----------------------------------------------------
# MOCK_MODE=true uses the built-in mock VTU provider (fake airtime/data/electricity/cable)
MOCK_MODE=true
# VTU provider real gateway (used when MOCK_MODE=false)
VTU_API_BASE_URL=
VTU_API_TOKEN=
# Simulated failure rate for mock mode (0.0 - 1.0). e.g. 0.15 = 15% failures
MOCK_FAIL_RATE=0.1
# Simulated delay in ms for mock provider responses
MOCK_DELAY_MS=1200

# --- Payments ----------------------------------------------------------------
# test = built-in simulated payment gateway (localhost)
# live = real gateway (paystack/flutterwave/monnify) when keys are present
PAYMENT_MODE=test
NEXT_PUBLIC_PAYMENT_MODE=test

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:3000/wallet

# Flutterwave
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_CALLBACK_URL=http://localhost:3000/wallet

# Monnify
MONNIFY_SECRET_KEY=
MONNIFY_PUBLIC_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_CALLBACK_URL=http://localhost:3000/wallet

# --- Seed admin account (used by `npm run prisma:seed`) ----------------------
SEED_ADMIN_EMAIL=admin@annashuwa.com
SEED_ADMIN_PASSWORD=Admin@1234
SEED_ADMIN_NAME="ANNASHUWA Admin"
SEED_ADMIN_PHONE=+2348000000000

# --- Email (optional SMTP for real password-reset emails. Dev prints link) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=ANNASHUWA VTU <no-reply@annashuwa.com>