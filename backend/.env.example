# ANNASHUWA VTU Backend - environment template
# Copy to .env and fill in. Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

NODE_ENV=production
APP_ENV=production
PORT=4000

# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/annashuwa_vtu

# Auth
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
JWT_ISSUER=annashuwa-vtu
JWT_AUDIENCE=annashuwa-vtu-web
SESSION_COOKIE=ans_session
REFRESH_COOKIE=ans_refresh

# Web app origin (used for redirects / password reset links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGIN=https://yourdomain.com

# VTU providers. The platform supports 5 upstream providers. Each is used in
# live HTTP mode only when its base URL + token are configured; otherwise it
# runs as a mock (live=false in /admin/vtu/providers). "mock" is the built-in
# simulator and is always available.
#
#   VTU_PROVIDER / DEFAULT_ACTIVE_PROVIDER select the default active provider
#   ("mock", "bilalsadasub", "rapidbills", "cheapdatahub", "vtung", "vtpass").
#
MOCK_MODE=true
MOCK_FAIL_RATE=0.1
MOCK_DELAY_MS=1200
VTU_PROVIDER=mock
DEFAULT_ACTIVE_PROVIDER=mock
AIRTIME_DEFAULT_MARGIN=0.06

# Provider operations.
#   VTU_MAX_FAILOVER_ATTEMPTS: how many fallback providers are tried after the
#     routed primary fails (0 disables failover; default 2).
#   VTU_FORCE_MOCK_FAIL=true makes the built-in mock throw hard errors (for
#     testing the failover path). Leave unset/ false in normal use.
VTU_MAX_FAILOVER_ATTEMPTS=2
VTU_FORCE_MOCK_FAIL=false
# Upper bound (ms) for any single upstream VTU HTTP call.
VTU_HTTP_TIMEOUT_MS=30000

# Background jobs - pending transaction reconciliation.
#   JOB_RECONCILE_ENABLED: set to "false" to disable the periodic job.
#   JOB_RECONCILE_INTERVAL_MS: how often the job runs (default 2 min).
#   JOB_RECONCILE_GRACE_MS: age before a PENDING/PROCESSING txn is eligible.
#   JOB_RECONCILE_MAX_AGE_MS: beyond this, unresolved txns are auto-refunded.
#   JOB_RECONCILE_BATCH: max txns handled per run.
JOB_RECONCILE_ENABLED=true
JOB_RECONCILE_INTERVAL_MS=120000
JOB_RECONCILE_GRACE_MS=300000
JOB_RECONCILE_MAX_AGE_MS=1800000
JOB_RECONCILE_BATCH=50

# Bilalsadasub
BILALSADASUB_BASE_URL=
BILALSADASUB_TOKEN=

# RapidBills
RAPIDBILLS_BASE_URL=
RAPIDBILLS_TOKEN=

# CheapDataHub
CHEAPDATAHUB_BASE_URL=
CHEAPDATAHUB_TOKEN=

# VTU.ng
VTUNG_BASE_URL=
VTUNG_TOKEN=

# VTpass (Basic auth: username + password/token via VTPASS_TOKEN)
VTPASS_BASE_URL=
VTPASS_USERNAME=
VTPASS_TOKEN=

# Payments. PAYMENT_MODE=test forces the TEST gateway.
PAYMENT_MODE=test
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=

# Seed (initial admin account)
SEED_ADMIN_EMAIL=admin@annashuwa.com
SEED_ADMIN_PASSWORD=Admin@1234
SEED_ADMIN_NAME=ANNASHUWA Admin
SEED_ADMIN_PHONE=+2348000000000

# Messaging (email/SMS abstraction). MESSENGER_PROVIDER=log for development.
MESSENGER_PROVIDER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ANNASHUWA VTU <no-reply@annashuwa.com>
SMS_PROVIDER=

# Rate limiting & abuse protection.
#   RATE_LIMIT_ENABLED: set to "false" to disable rate limiting (local testing
#     only - never disable in production).
#   RATE_LIMIT_CLEANUP_MS: how often the in-memory hit store is swept for stale
#     keys (bounds memory; default 30s).
#   RATE_LIMIT_MAX_KEYS: cap on store size; least-recent keys evicted beyond it.
#   MAX_JSON_BODY_BYTES: parsed JSON body cap (default 1MB, matches the express
#     body limit).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CLEANUP_MS=30000
RATE_LIMIT_MAX_KEYS=10000
MAX_JSON_BODY_BYTES=1048576